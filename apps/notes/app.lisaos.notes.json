{
  "lisa_manifest": 1,
  "app_id": "app.lisaos.notes",
  "mcp": { "transport": "unix", "activatable": false },
  "tools": [
    {
      "name": "create_note",
      "tier": "write",
      "description": "Create a note with a title and optional body",
      "input_schema": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "body": { "type": "string" }
        }
      },
      "undo": { "tool": "delete_note", "map": { "id": "$result.id" } }
    },
    {
      "name": "list_notes",
      "tier": "read",
      "description": "List active notes (id, title, created), oldest first",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "read_note",
      "tier": "read",
      "description": "Read one note in full, body included",
      "input_schema": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" }
        }
      }
    },
    {
      "name": "update_note",
      "tier": "write",
      "description": "Replace a note's title and body",
      "undo": {
        "tool": "update_note",
        "map": {
          "id": "$input.id",
          "title": "$result.previous_title",
          "body": "$result.previous_body"
        }
      },
      "input_schema": {
        "type": "object",
        "required": ["id", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string", "maxLength": 120 },
          "body": { "type": "string" }
        }
      }
    },
    {
      "name": "search_notes",
      "tier": "read",
      "description": "Search active notes for a substring of title or body (case-insensitive for ASCII letters only; %, _ and \\ match literally), newest first",
      "input_schema": {
        "type": "object",
        "required": ["query"],
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string", "maxLength": 200 },
          "limit": { "type": "integer", "minimum": 1, "default": 20 }
        }
      }
    },
    {
      "name": "delete_note",
      "tier": "write",
      "description": "Soft-delete a note; restorable via restore_note",
      "input_schema": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" }
        }
      },
      "undo": { "tool": "restore_note", "map": { "id": "$input.id" } }
    },
    {
      "name": "restore_note",
      "tier": "write",
      "description": "Restore a soft-deleted note",
      "input_schema": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" }
        }
      }
    }
  ]
}
