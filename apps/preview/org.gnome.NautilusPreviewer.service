# Space-to-preview in Files, when Preview is not already running.
#
# The name is VERSIONLESS on purpose: nautilus 50.2.2 dials
# "org.gnome.NautilusPreviewer" (the 2 is only in the interface), and it
# ping-gates the name at startup — if the ping fails, every Space press
# is dropped before any call is made. That ping also AUTO-STARTS us
# headless at the first Files launch; --previewer-service tells the app
# to register and wait rather than present an empty window at login.
[D-BUS Service]
Name=org.gnome.NautilusPreviewer
Exec=/usr/bin/lisa-app preview/lisa-preview.js --previewer-service
