# Rust
/target/

# macOS
.DS_Store

# mkosi build outputs (Track I images are CI artifacts, never committed).
# CI writes lisa.raw / lisa.vmlinuz / lisa.initrd / initrd.cpio.zst
# straight into os/mkosi/ (no OutputDirectory=), so a local build drops
# them there too — keep them out of the tree.
os/mkosi/mkosi.output/
os/mkosi/*.cache/
os/mkosi/mkosi.builddir/
os/mkosi/lisa.raw
os/mkosi/lisa.vmlinuz
os/mkosi/lisa.initrd
os/mkosi/lisa*.efi
os/mkosi/initrd.cpio.zst

# makepkg working dirs and built packages (os/packages/*). CI builds in a
# throwaway container clone, but a local `makepkg` drops these in-tree —
# and lisa-audio-cs8409/src/ alone holds a ~150 MB kernel tarball.
os/packages/*/src/
os/packages/*/pkg/
os/packages/*/*.pkg.tar.*
os/packages/*/*.log

# Local model stores / scratch
*.gguf
.claude/
lisa-app/
.ci-cache/
repo-out/

# QEMU/rustc crash dumps — 300 MB each, never wanted in the tree.
*.core

# build-keymap.py imports check-shell-keys.py rather than reimplementing
# its parsing, so Python now leaves bytecode next to the repo tools.
__pycache__/
