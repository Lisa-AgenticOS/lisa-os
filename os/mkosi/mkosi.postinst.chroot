#!/usr/bin/env bash
# Runs inside the image chroot after package installation. Enables the
# Lisa daemon when it's part of the build (USB/full images); minimal CI
# boot-check images without the packages are unaffected.
set -euo pipefail

if [ -f /usr/lib/systemd/system/lisa-inferenced.service ]; then
    systemctl enable lisa-inferenced.service
fi

# Out-of-image app payloads (ADR-0023 phase 1, issue #51): payloads the
# image does not bake arrive on the apps channel, so a booted system has to
# be able to go get them. The timer is the safety net for the device that
# was offline when its slot was updated — without it, "no network at first
# boot" would mean "a missing surface, and no way to know why".
if [ -f /usr/lib/systemd/system/lisa-apps-sync.timer ]; then
    systemctl enable lisa-apps-sync.timer
fi

# Locale generation: mkosi's Locale= bakes /etc/locale.conf (LANG=), but
# on Arch the locale must also be *generated* or glibc silently falls
# back to C. Uncomment en_US.UTF-8 and build it so LANG= actually
# resolves. Timezone/keymap need no generation (localtime symlink +
# vconsole.conf are baked by mkosi Timezone=/Keymap=).
if [ -f /etc/locale.gen ]; then
    sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    grep -qxF 'en_US.UTF-8 UTF-8' /etc/locale.gen || echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen
    locale-gen
fi

# Brand as Lisa OS. Settings › About, hostnamectl, the login MOTD and
# scripts all read os-release, which the base image inherits from Arch.
# Rewrite the identity fields *in place* so BUILD_ID and mkosi's appended
# IMAGE_ID/IMAGE_VERSION survive. /etc/os-release symlinks here, so every
# reader follows it. LOGO=lisa-logo resolves to the mark shipped under
# hicolor (mkosi.extra); GNOME's About panel renders it. ID_LIKE=arch
# keeps arch-aware tooling working.
if [ -f /usr/lib/os-release ]; then
    _repo=https://github.com/Lisa-AgenticOS/lisa-os
    sed -i \
        -e 's|^NAME=.*|NAME="Lisa OS"|' \
        -e 's|^PRETTY_NAME=.*|PRETTY_NAME="Lisa OS"|' \
        -e 's|^ID=.*|ID=lisa|' \
        -e "s|^HOME_URL=.*|HOME_URL=\"$_repo\"|" \
        -e "s|^DOCUMENTATION_URL=.*|DOCUMENTATION_URL=\"$_repo\"|" \
        -e "s|^SUPPORT_URL=.*|SUPPORT_URL=\"$_repo/issues\"|" \
        -e "s|^BUG_REPORT_URL=.*|BUG_REPORT_URL=\"$_repo/issues\"|" \
        -e 's|^LOGO=.*|LOGO=lisa-logo|' \
        -e 's|^ANSI_COLOR=.*|ANSI_COLOR="1;38;2;109;69;201"|' \
        -e '/^PRIVACY_POLICY_URL=/d' \
        /usr/lib/os-release
    grep -q '^ID_LIKE=' /usr/lib/os-release || \
        sed -i '/^ID=lisa/a ID_LIKE=arch' /usr/lib/os-release
fi

# Boot diagnosis: every boot (including one that only reaches
# emergency/rescue) dumps its journal to the FAT ESP, readable from any
# machine the stick is plugged into.
if [ -f /usr/lib/systemd/system/lisa-boot-report.service ]; then
    systemctl enable lisa-boot-report.service
fi

# ESP self-repair on every healthy boot (ADR-0022 phase 1): stash the
# booted UKI on /var, restore it when the ESP lost it, drop dangling
# entries — the #20 incident's manual rescue, automated.
if [ -f /usr/lib/systemd/system/lisa-boot-repair.service ]; then
    systemctl enable lisa-boot-repair.service
fi

# Bluetooth for Apple Magic input devices when the stack is present.
if [ -f /usr/lib/systemd/system/bluetooth.service ]; then
    systemctl enable bluetooth.service
fi

# GNOME desktop session (PLAN §3 desktop strategy; the M4 §5.7 shell
# surfaces load into it). Minimal CI boot-check images without gdm are
# unaffected. Enabling gdm is not enough — it only starts once
# graphical.target is the boot target, so set that explicitly. Without
# this the field iMac booted to a text console (gdm enabled but never
# reached). Belt-and-suspenders with 00-lisa.preset which enables gdm.
if [ -f /usr/lib/systemd/system/gdm.service ]; then
    systemctl enable gdm.service
    systemctl set-default graphical.target
fi

# Field-test login — PROVISIONAL until the M7 first-boot OOBE (PLAN §6)
# creates real users: account `lisa`, password `lisa`, GDM autologin
# (mkosi.extra/etc/gdm/custom.conf). The password still guards sudo and
# the lock screen; wheel sudo drop-in ships in mkosi.extra. logind
# grants seat access — no extra groups needed. See os/mkosi/README.md.
if [ -f /usr/lib/systemd/system/gdm.service ] && ! id lisa &>/dev/null; then
    # useradd creates the `lisa` user AND its primary group `lisa` — which
    # is the group that owns the shared model store (/var/lib/lisa-models,
    # see tmpfiles.d/lisa-models.conf), so downloads land group-writable
    # and lisa-inferenced reads them. Do NOT pre-create the group: that
    # collides with the user's own primary group and useradd fails (9).
    useradd -m -G wheel -s /bin/bash lisa
    echo 'lisa:lisa' | chpasswd
fi

# Rootless containers need a subordinate uid/gid range (#130 phase 0,
# ADR-0034). Without /etc/subuid + /etc/subgid, user-namespace mapping
# fails QUIETLY — podman degrades to single-uid mode and everything
# built on `lisa dev` inherits the breakage with no error naming the
# cause. useradd would have allocated a range itself had these files
# existed at creation time; on this image they do not, so write the
# conventional first range explicitly. Nightly asserts it (the
# lisa-apps-sync.timer enablement regression is the precedent for
# assert-what-postinst-wrote).
if id lisa &>/dev/null; then
    echo 'lisa:100000:65536' > /etc/subuid
    echo 'lisa:100000:65536' > /etc/subgid
fi

# Suppress GNOME's first-login wizard (gnome-initial-setup) for the
# autologin user, so first login lands straight in the session instead
# of a welcome/timezone/account tour. Harmless if g-i-s isn't installed
# (we don't ship the `gnome` group). systemd-firstboot is separately
# silenced by the baked Timezone/Locale/Keymap in mkosi.conf.
if id lisa &>/dev/null; then
    install -d -o lisa -g lisa -m 0755 /home/lisa/.config
    echo yes > /home/lisa/.config/gnome-initial-setup-done
    chown lisa:lisa /home/lisa/.config/gnome-initial-setup-done
    # Factory mirror (ADR-0019): a fresh dedicated home partition mounts an
    # empty btrfs over /home, hiding the baked state above; tmpfiles
    # (lisa-home-factory.conf) copies this factory tree in exactly once.
    install -d /usr/share/factory/home
    cp -a /home/lisa /usr/share/factory/home/lisa
fi

# aarch64 (ADR-0021): ALARM's linux-aarch64 still uses mkinitcpio-era
# packaging — the kernel lands at /boot/Image and NOT at
# /usr/lib/modules/<kver>/vmlinuz, which is where mkosi discovers kernels
# for UKI assembly. Without this, the build dies at the end with "A
# bootable image was requested but no kernel was found" (exactly where
# the local ALARM container build stopped, 2026-07-25). Copy it into
# place; no-op on x86_64, where Arch's `linux` ships vmlinuz in modules.
if [ -e /boot/Image ]; then
    for _d in /usr/lib/modules/*/; do
        [ -e "${_d}vmlinuz" ] || cp /boot/Image "${_d}vmlinuz"
    done
fi

# The ESP mounts at /efi from the baked fstab (gpt-auto is disabled,
# ADR-0018) — the mountpoint must exist.
install -d /efi

# Networking, one owner per image flavor:
# - Desktop images: NetworkManager owns ALL interfaces (Wi-Fi via the
#   GNOME quick-settings UI — the field test proved iwctl-only is a
#   dead end; ethernet DHCP is NM default behavior). wifi.backend=iwd
#   (mkosi.extra conf) keeps iwd as the supplicant, so the existing
#   package choice stands; iwd.service is enabled because NM does not
#   auto-start its backend. The networkd DHCP profile enable below is
#   deliberately skipped so two DHCP clients never race on en*.
# - Images without NM: the networkd DHCP profile (USB images ship it
#   via ExtraTrees) keeps wired networking as before.
# (Authoritative enablement is os/mkosi/mkosi.extra/.../00-lisa.preset,
# which survives mkosi's preset pass; these are belt-and-suspenders.)
if [ -f /usr/lib/systemd/system/NetworkManager.service ]; then
    systemctl enable NetworkManager.service || true
    # ...and nobody else owns an interface. networkd is enabled by the
    # distro default, so BOTH ran on desktop images: NetworkManager
    # holding every link, networkd holding none, and
    # systemd-networkd-wait-online waiting for a link that will never
    # come up under its management. It timed out on every boot, so
    # `systemctl --failed` was never empty (#160).
    #
    # Worse than untidy: a permanently-failed unit is the first thing
    # anyone checks on a misbehaving machine, and this trained both
    # people and `lisa doctor` to skim a list that always had an entry
    # in it. Two managers on one host is also a hazard waiting for the
    # day something ships a .network file.
    #
    # Done HERE and not in 00-lisa.preset because that preset is shared
    # with images that have no NetworkManager, where networkd IS the
    # networking — disabling it there would leave them with none.
    systemctl disable systemd-networkd.service 2>/dev/null || true
    systemctl disable systemd-networkd.socket 2>/dev/null || true
    systemctl disable systemd-networkd-wait-online.service 2>/dev/null || true
    # The disable above is NOT enough, and shipping only it re-broke the
    # device (#160, seen on 20260731.61): every updated slot boots with
    # a fresh machine-id, first boot runs preset-all, and
    # 90-systemd.preset says `enable systemd-networkd` — so the
    # symlinks the lines above removed were recreated on the device's
    # very next boot. Presets are first-match-wins in filename order,
    # so the durable answer is a preset that sorts earlier. Written
    # HERE, not in 00-lisa.preset, for the same reason as the disable:
    # this branch only runs where NetworkManager exists; on
    # networkd-managed images this file is never created.
    cat > /usr/lib/systemd/system-preset/01-lisa-networkmanager.preset <<'EOF'
# NetworkManager images: exactly one network manager (#160). This file
# outranks 90-systemd.preset's `enable systemd-networkd`, and unlike a
# postinst `systemctl disable` it survives the preset-all that every
# freshly-updated slot runs on first boot.
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-wait-online.service
EOF
    systemctl enable systemd-resolved.service || true
    systemctl enable iwd.service 2>/dev/null || true
    # Persist Wi-Fi across A/B updates: NetworkManager writes profiles to
    # /etc/NetworkManager/system-connections, which is per-slot (lost on
    # update). Redirect it to the persistent /var partition (dir created by
    # tmpfiles.d/lisa-network-persist.conf), so a saved Wi-Fi survives.
    if [ -d /etc/NetworkManager ]; then
        rm -rf /etc/NetworkManager/system-connections
        ln -sfn /var/lib/NetworkManager/system-connections \
            /etc/NetworkManager/system-connections
    fi
elif [ -f /etc/systemd/network/80-dhcp.network ]; then
    systemctl enable systemd-networkd.service systemd-resolved.service
fi

# Automatic update staging: check the release channel daily, stage into
# the inactive slot; reboots apply, boot-counting rolls back failures.
if [ -f /usr/lib/sysupdate.d/50-root.transfer ]; then
    systemctl enable systemd-sysupdate.timer || true
fi

# Compile the GDM greeter dconf DB — the Lisa wordmark + violet accent
# ship as /etc/dconf/db/gdm.d/ via mkosi.extra; `dconf update` turns them
# into the binary /etc/dconf/db/gdm the login screen actually reads.
# Without this the greeter falls back to GNOME/Arch defaults (arch logo,
# blue accent).
if command -v dconf >/dev/null 2>&1 && [ -d /etc/dconf/db/gdm.d ]; then
    dconf update || true
fi

# Compile the image-level gschema overrides (wallpaper/accent/font in
# mkosi.extra) into gschemas.compiled — base images without the lisa
# packages otherwise show GNOME stock branding (every CI screenshot was
# the blue wallpaper). Package installs re-run this via pacman hooks.
if command -v glib-compile-schemas >/dev/null 2>&1 &&
    [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi

# Podman ships four user units and its own pacman install ENABLES them:
# podman.service, podman.socket, podman-auto-update.timer and
# podman-clean-transient.service. None of them was asked for.
#
# podman.socket is the one that matters. It exposes podman's REST API on
# $XDG_RUNTIME_DIR/podman/podman.sock — a socket that can create,
# start and mount containers, taking its instructions as HTTP rather
# than as argv. Lisa's guard classifies COMMANDS (`check_command`,
# ADR-0029): an agent that can reach a REST socket asks for a container
# without ever forming a command line, so nothing is there to classify.
# That is a surface added by a dependency, not by a decision — exactly
# what "no undeclared surfaces" is meant to prevent, and #130's design
# drives podman through its CLI, where the guard can see it.
#
# Two mechanisms, because one is not enough (the #160 lesson): remove
# the symlinks pacman made, AND write a user preset that outranks
# podman's own, so a `systemctl --user preset-all` on a fresh slot does
# not quietly put them back.
if [ -e /usr/lib/systemd/user/podman.socket ]; then
    mkdir -p /usr/lib/systemd/user-preset
    cat > /usr/lib/systemd/user-preset/01-lisa-podman.preset <<'EOF'
# Podman's own units stay off (#130). `lisa dev` drives podman through
# its CLI, where the guard can classify what is being asked for; the
# REST socket takes the same requests as HTTP, where it cannot. Sorts
# before podman's shipped preset, and presets are first-match-wins.
disable podman.service
disable podman.socket
disable podman-auto-update.timer
disable podman-clean-transient.service
EOF
    for u in podman.service podman.socket podman-auto-update.timer \
        podman-clean-transient.service; do
        rm -f "/etc/systemd/user/default.target.wants/$u" \
            "/etc/systemd/user/sockets.target.wants/$u" \
            "/etc/systemd/user/timers.target.wants/$u"
    done
fi

# GNOME ships org.freedesktop.IBus.session.GNOME.service enabled by
# preset, and on Lisa it fails on every boot:
#
#   sh[2731]: current session already has an ibus-daemon.
#   Failed to start IBus Daemon for GNOME.
#
# Measured on the reference iMac (20260801.62, 20h uptime): the unit is
# `failed`, MainPID=0, and `pgrep -c ibus-daemon` is 0 — so it is not
# losing a race with a working daemon, there is simply no ibus on this
# system at all. Lisa's IME is fcitx5 (§5.7.3, running as pid 2202), and
# GNOME's own input-source switcher is moved to Super+Shift+Space.
#
# So this unit provides nothing and fails permanently. That matters
# beyond tidiness: `systemctl --user --failed` is the first thing anyone
# reads when a desktop misbehaves, and a list with a standing false
# alarm in it is a list people stop reading. `lisa doctor` prints it.
#
# Same two mechanisms as the podman block above — the preset is what
# survives a fresh slot's preset-all.
if [ -e /usr/lib/systemd/user/org.freedesktop.IBus.session.GNOME.service ]; then
    mkdir -p /usr/lib/systemd/user-preset
    cat > /usr/lib/systemd/user-preset/01-lisa-ibus.preset <<'EOF'
# Lisa's input method is fcitx5; GNOME's IBus unit has no daemon to
# manage here and fails on every boot. Sorts before GNOME's preset.
disable org.freedesktop.IBus.session.GNOME.service
EOF
    rm -f /etc/systemd/user/default.target.wants/org.freedesktop.IBus.session.GNOME.service \
        /usr/lib/systemd/user/default.target.wants/org.freedesktop.IBus.session.GNOME.service \
        /usr/lib/systemd/user/gnome-session.target.wants/org.freedesktop.IBus.session.GNOME.service
fi

# The pacman database does not reach the shipped disk: repart gives
# /var its own (empty, tmpfiles-repopulated) partition and excludes
# another partition's subtree from the root copy, so /var/lib/pacman
# ships NOWHERE. "Which packages are in this image?" was therefore
# unanswerable on the artifact — found when the ADR-0039 step-5
# desktop check's FIRST execution read the mounted root for the db
# and got "No such file or directory" (release run 31012229114).
# Record the answer where it survives: /usr, written here while the
# db still exists. release.yml and nightly.yml assert against this
# file; devices get an honest manifest of their image as a bonus.
if command -v pacman >/dev/null 2>&1 && [ -d /var/lib/pacman/local ]; then
    install -d /usr/lib/lisa
    pacman -Q > /usr/lib/lisa/packages.manifest
fi

# --- One session in the greeter, and it is ours (#284) ---------------
#
# `gnome-session` stays in the image (ADR-0048 keeps it as foundation),
# and it ships /usr/share/wayland-sessions/gnome.desktop. So the greeter
# listed TWO sessions: "GNOME" and "Lisa Desktop". Both run
# /usr/bin/gnome-shell, which IS Lisa Desktop (the fork installs at
# /usr), so the GNOME entry started our shell *without* Lisa's session
# drop-in — the dock, the overlay and the semantic launcher missing, and
# no error anywhere to say why. A person picking the entry named after
# the desktop they recognise got a half-configured Lisa.
#
# This is the image being deliberate about what it contains: an entry we
# do not want offered does not go in. It is NOT a patch to gnome-session
# (rule 11 — the package is installed unmodified; only this image's copy
# of one .desktop is dropped).
#
# TRACK I ONLY, deliberately. Track L layers onto somebody's existing
# Arch/Omarchy, where GNOME may be the desktop they actually use;
# deleting their session entry would be exactly the "between a person
# and their own machine" move ADR-0029 forbids.
#
# SAFE because GDM does not require the name it falls back to. Its
# hardcoded default is the string "gnome" (daemon/gdm-session.c,
# get_fallback_session_name); when that does not resolve it enumerates
# every .desktop under the system session dirs, sorts them, and takes
# the first. Read from gdm's source on 2026-08-06, not assumed. With
# stock's entry gone ours is the only one, so it is both the listed
# session and the fallback — belt and braces with the accountsservice
# factory record, which already names it.
#
# Order matters: assert OURS is present BEFORE removing anything. A
# build that dropped the stock entry and shipped no replacement would
# produce an image that cannot start a session at all.
_ours=/usr/share/wayland-sessions/lisa-desktop.desktop
if [ ! -e "$_ours" ]; then
    echo "postinst: $_ours is missing — refusing to drop stock's session" >&2
    echo "          entries, which would leave the image with no session." >&2
    exit 1
fi
for _s in /usr/share/wayland-sessions/gnome*.desktop \
          /usr/share/xsessions/gnome*.desktop; do
    [ -e "$_s" ] || continue
    echo "postinst: dropping stock session entry $_s (#284)"
    rm -f "$_s"
done
unset _ours _s
