# Resolve the Lisa Rescue entry's root device in the initrd (ADR-0022
# phase 2): pick the newest root slot that actually mounts. Inert for
# normal boots — the script exits immediately unless the cmdline asks
# for /dev/lisa/newest-good.
[Unit]
Description=Resolve the newest mountable Lisa root slot (rescue entry)
DefaultDependencies=no
# No ConditionPathExists=/etc/initrd-release: mkosi-initrd does not
# reliably ship that file, and a silently-skipped unit looked exactly
# like a resolver bug in the nightly. The script's own cmdline check
# (root=/dev/lisa/newest-good) is the real gate — it exits instantly
# on any normal boot.
Before=initrd-root-device.target sysroot.mount
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/lisa/newest-good-root.sh
StandardOutput=journal+console

[Install]
WantedBy=initrd-root-device.target
