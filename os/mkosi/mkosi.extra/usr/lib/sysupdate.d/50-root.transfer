# Root slot updates from GitHub Releases (the update channel). The
# releases/latest/download URL always redirects to the newest release,
# so every install sees new versions from one fixed URL. Verify=no until
# GPG-signed manifests land (M1 hardening); transport is HTTPS +
# SHA256SUMS integrity.
[Transfer]
Verify=no
# Issue #20 (field iMac, v22→v26): sysupdate has NO built-in guard for
# the partition backing / — vacuuming for InstancesMax evicts the OLDEST
# installed version, and when the booted slot is the oldest of a full
# slot set, the RUNNING root gets erased mid-session. The documented
# guard is this opt-in setting (sysupdate.d(5), since systemd v251):
# "Protected versions are never removed while making room for new,
# updated versions ... to ensure that the currently booted OS version
# ... is not replaced/overwritten during updates". %A expands to the
# running os-release IMAGE_VERSION, which release.yml bakes to match the
# root_@v slot label. Nightly ab-sysupdate proves this in the incident's
# three-version shape.
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/Lisa-AgenticOS/lisa-os/releases/latest/download/
MatchPattern=lisa_@v.root.xz

[Target]
Type=partition
Path=auto
MatchPattern=root_@v
MatchPartitionType=root
InstancesMax=2
