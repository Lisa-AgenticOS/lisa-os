[Transfer]
Verify=no
# Keep the booted version's UKI while vacuuming for InstancesMax —
# without this the boot entry of the running (oldest) version can be
# deleted during staging (issue #20; see 50-root.transfer for the full
# story; sysupdate.d(5) ProtectVersion=, since systemd v251).
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/Lisa-AgenticOS/lisa-os/releases/latest/download/
MatchPattern=lisa_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=esp
MatchPattern=lisa_@v.efi
InstancesMax=2
