# xdg-desktop-portal-lisa — the trust boundary (PLAN §5.5, ADR-0008).
#
# A per-user *session* service (systemd --user), unlike the system
# daemons: grants, consent, and the per-user ledger are per-user by
# construction. D-Bus-activated via dev.lisaos.Portal; apps reach it on
# the session bus, it reaches dev.lisaos.Inference1 the same way. The
# portal itself needs no network — it brokers fds, it never carries
# model traffic.

[Unit]
Description=Lisa OS trust-boundary portal
Documentation=https://github.com/Lisa-AgenticOS/lisa-os/blob/main/portals/xdg-desktop-portal-lisa/README.md

[Service]
Type=dbus
BusName=dev.lisaos.Portal
ExecStart=/usr/bin/xdg-desktop-portal-lisa
Restart=on-failure
RestartSec=2

# --- Hardening (user-service subset; no DynamicUser in --user scope) ---
NoNewPrivileges=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
# NO mount-based sandboxing (PrivateTmp, ProtectSystem, ProtectHome,
# ProtectKernel*) in this unit, and the omission is load-bearing
# (#161): a per-user manager can only apply those inside a private
# user namespace, and from there /proc/<pid>/exe and
# /proc/<pid>/root/.flatpak-info of every peer are EACCES. This portal
# IS the caller-identification surface (#106, #107) — sandboxed that
# way it cannot identify anyone, so every grant decision fails closed
# and the trust boundary is simply off. os/repo-tools/check-user-units.py
# holds the line.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
