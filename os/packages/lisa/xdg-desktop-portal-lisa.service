# xdg-desktop-portal-lisa — the trust boundary (PLAN §5.5, ADR-0008).
#
# A per-user *session* service (systemd --user), unlike the system
# daemons: grants, consent, and the per-user ledger are per-user by
# construction. D-Bus-activated via dev.lisaos.Portal; apps reach it on
# the session bus, it reaches dev.lisaos.Inference1 the same way. The
# portal itself needs no network — it brokers fds, it never carries
# model traffic.

[Unit]
Description=Lisa OS trust-boundary portal
Documentation=https://github.com/Lisa-AgenticOS/lisa-os/blob/main/portals/xdg-desktop-portal-lisa/README.md

[Service]
Type=dbus
BusName=dev.lisaos.Portal
ExecStart=/usr/bin/xdg-desktop-portal-lisa
Restart=on-failure
RestartSec=2

# --- Hardening (user-service subset; no DynamicUser in --user scope) ---
NoNewPrivileges=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
# NO mount-based sandboxing (PrivateTmp, ProtectSystem, ProtectHome,
# ProtectKernel*) in this unit, and the omission is load-bearing
# (#161): a per-user manager can only apply those inside a private
# user namespace, and from there /proc/<pid>/exe and
# /proc/<pid>/root/.flatpak-info of every peer are EACCES. This portal
# IS the caller-identification surface (#106, #107) — sandboxed that
# way it cannot identify anyone, so every grant decision fails closed
# and the trust boundary is simply off. os/repo-tools/check-user-units.py
# holds the line.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077

# EGRESS SANDBOX — and it was MISSING until 2026-08-05 (#285).
#
# The comment at the top of this file has said "the portal itself needs
# no network" since it was written. That was a description, not a
# mechanism: a process launched under this unit's shipped [Service]
# block reached example.com, proven by execution once the #275 harness
# started RUNNING sandboxes instead of grepping for them.
#
# It is the same defect as lisa-inferenced-dbus.service (47fa7c6),
# landing on the one component whose entire job is to sit between an
# app and what it should not have. A trust boundary that can dial out
# is a trust boundary in name.
#
# AF_UNIX only, matching lisa-contextd/lisa-agentd/lisa-notes: the
# portal brokers fds over the session bus and reaches
# dev.lisaos.Inference1 the same way. It never carries model traffic —
# that is the broker's job, and the broker is the only unit here that
# may egress (rule 5, PLAN §4 dataflow rule 2).
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
