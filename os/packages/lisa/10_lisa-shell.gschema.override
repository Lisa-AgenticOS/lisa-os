# Lisa OS session defaults, shipped by lisa-shell (compiled into the
# system gschemas by glib2's pacman hook; unknown-schema stanzas are
# ignored with a warning on non-GNOME hosts).
#
# - The M4 surfaces (PLAN §5.7) are live on first login: all three Shell
#   extensions default-enabled (overlay, launcher, and the ADR-0035
#   desktop — always-visible dock + bottom-right hot corner).
# - macOS-style summon keys: Super+Space is the Spotlight-style search
#   (§5.7.2) and Super+Shift+Space the assistant overlay (§5.7.1). Both
#   are declared by the extension that answers them, in
#   shell/launcher/schemas/ and shell/overlay-extension/schemas/ — not
#   here. GNOME's input-source switcher, whose Super+Space default
#   collides, moves out of the way below; that remap is this file's job
#   because it is a GNOME key, not a Lisa one.

[org.gnome.shell]
enabled-extensions=['lisa-overlay@lisa-os.org', 'lisa-launcher@lisa-os.org', 'lisa-desktop@lisa-os.org', 'lisa-glass@lisa-os.org']
# The dock. Same list, same order, as
# os/mkosi/mkosi.extra/etc/dconf/db/local.d/30-lisa-dock — which is
# where the reasoning lives, and which the two tracks need separately
# (dconf ships only in the image; this override is all Track L gets).
# check-dock.py fails the lint gate if they ever disagree.
#
# It has to be in THIS stanza. It shipped under
# [org.gnome.settings-daemon.plugins.power] from 8faf668 until #263,
# where favorite-apps is not a key: glib-compile-schemas warned once
# during the build and dropped the line, so every image since carried a
# dock default that had never been applied. Measured on the device,
# 2026-08-04: `GSETTINGS_BACKEND=memory gsettings get org.gnome.shell
# favorite-apps` returned GNOME's stock Epiphany/Calendar/Nautilus/
# Software/TextEditor/Calculator, of which only Nautilus is installed —
# which is exactly the one-icon dock the pin was meant to fix.
favorite-apps=['app.lisaos.Assistant.desktop', 'org.gnome.Nautilus.desktop', 'app.lisaos.Surfer.desktop', 'app.lisaos.Mail.desktop', 'app.lisaos.Preview.desktop', 'app.lisaos.LedgerApp.desktop', 'org.gnome.Console.desktop']

# toggle-overview is NOT bound to Super+Space (#255). It was, as a
# stand-in for a Spotlight key nobody had built: it opened the window
# picker, which is not a search box, and it left the real chord occupied
# so the launcher's own binding would have collided with it the moment
# it landed. GNOME's own default for this key is empty; it stays empty.

# The Lisa OS interface font: Rubik (a warm, slightly-rounded geometric
# sans, OFL — shipped under /usr/share/fonts/rubik). Monospace is left at
# the system default. Overridable per-user in Settings.
[org.gnome.desktop.interface]
font-name='Rubik 11'
document-font-name='Rubik 11'
# Lisa violet accent (de-Arch the blue). GNOME's accent palette is a
# fixed enum; 'purple' is the nearest to Lisa violet (#6D45C9). Exact-hex
# accent would need a libadwaita CSS override — a follow-up.
accent-color='purple'

# Default Lisa wallpaper (issue #24) — the violet field replaces GNOME's
# stock blue. The SVGs ship in the Track I image (os/mkosi/mkosi.extra);
# Track L installs this package but not those files, so primary-color is
# the honest fallback there: a solid brand violet, not a broken path.
# User-changeable in Settings as normal (these are defaults, not locks).
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/lisa/lisa-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/lisa/lisa-dark.svg'
picture-options='zoom'
primary-color='#6D45C9'

# Lock screen blurs the same field (GNOME blurs/dims whatever this names).
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/lisa/lisa-light.svg'
picture-options='zoom'
primary-color='#6D45C9'

[org.gnome.desktop.wm.keybindings]
switch-input-source=['<Control><Super>space']
switch-input-source-backward=[]

# NO automatic suspend (field iMac 18,x: amdgpu cannot resume under
# Linux — suspend is a hard power-off in practice, killing SSH and
# stranding the machine until a power-button cycle). Blank the screen,
# never sleep the box. Belt-and-braces with the masked systemd sleep
# targets in the image (mkosi.extra).
[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
