# lisa-inferenced-dbus — session-bus surface dev.lisaos.Inference1
# (PLAN §5.1, Appendix A). Runs per-user alongside the hardened system
# service (lisa-inferenced.service): that one owns compute + the
# OpenAI-compat HTTP port and deliberately cannot reach the user's
# session bus (DynamicUser ≠ the login user's bus socket), so this
# companion gives the shell surfaces — assistant overlay (§5.7.1) and
# the launcher's "Ask Lisa" handoff (§5.7.2) — their engine surface.
# Same binary, same shared model store, loopback HTTP on 7778 (the
# system service owns 7777); the ledger it gates on is the user's own.
#
# Bus-loss behavior: the daemon exits when its D-Bus connection dies
# (watchdog in main.rs); Restart=on-failure puts the name back.

[Unit]
Description=Lisa inference session-bus surface (dev.lisaos.Inference1)

[Service]
Type=exec
# --config enables the BYO remote tier (ADR-0010/0015) so `remote:*` model
# hints route to the user's lisa-remoted broker over its session socket. This
# gives inferenced NO network access — it reaches a loopback unix socket; the
# broker owns egress, and the broker still gates every request on per-scope
# consent + a stored credential (nothing leaves by default, rule 5).
Environment=LISA_REMOTED_SOCKET=%t/lisa/remoted.sock
# --socket serves the same HTTP API on a unix socket, for callers that
# are forbidden IP sockets outright. lisa-contextd runs with
# RestrictAddressFamilies=AF_UNIX, so it cannot reach :7778 to embed —
# the loopback port is still a network socket (#163). Spelled out rather
# than left to the daemon's default, so the path the context fabric
# depends on is visible in the unit that owns it. As of #288
# lisa-harnessd — the model host — reaches this daemon the same way, and
# is confined to AF_UNIX because of it.
ExecStart=/usr/bin/lisa-inferenced --dbus --bind 127.0.0.1:7778 --socket %t/lisa/inferenced.sock --engine llama --models-dir /var/lib/lisa-models/refs --config /usr/share/lisa/inferenced-remote.toml
Restart=on-failure
RestartSec=2

# NOT CONFINED. Read that before reading the directives.
#
# Written on 2026-08-05 as an "EGRESS SANDBOX ... mirrors
# lisa-inferenced.service", it was neither. This unit is installed into
# /usr/lib/systemd/user/ and runs under `systemd --user`, where
# IPAddressDeny=/IPAddressAllow= are a NO-OP: they are a cgroup BPF
# program and an unprivileged user manager cannot load one. The journal
# says it in as many words —
#
#   lisa-agentd.service: unit configures an IP firewall, but not running
#   as root.
#
# — and it was measured on the reference iMac with transient user units:
# with AF_INET allowed, `curl http://example.com` returns HTTP 200
# through exactly these directives. So the 47fa7c6 commit that added
# them claimed a confinement that did not exist, and this note replaces
# that claim (#288). The only directive that confines an unprivileged
# unit is RestrictAddressFamilies=, a seccomp filter on socket(2).
#
# WHY AF_INET IS STILL HERE, honestly: this daemon LISTENS on
# 127.0.0.1:7778, and two GJS surfaces are still its clients over that
# port — shell/assistant/lisa-assistant.js (GET /v1/models, the model
# picker) and shell/overlay-extension/backend/lisa-overlayd.js (POST
# /v1/chat/completions, the streaming chat lane). Both use libsoup, which
# has no unix-socket transport, so dropping the bind would take the
# assistant's model list and the overlay's chat lane with it. Taking
# AF_UNIX here needs one of:
#
#   * socket activation — a lisa-inferenced-dbus.socket with
#     ListenStream=127.0.0.1:7778, so the USER MANAGER creates the
#     listening socket and passes the fd. RestrictAddressFamilies=
#     filters socket(2) only, never accept(2) on an inherited fd, so the
#     daemon could serve :7778 while being unable to create any IP socket
#     of its own; or
#   * moving both GJS callers off HTTP onto Gio.SocketClient +
#     Gio.UnixSocketAddress (hand-framed HTTP, including chunked SSE) or
#     onto dev.lisaos.Inference1.
#
# Until one of those lands this unit is listed in USER_SCOPE_INET_DEBT in
# os/repo-tools/check-egress-units.py, which is a debt, not a
# dispensation. What #288 DID close is the sharper half: lisa-harnessd,
# the process that hosts the model, no longer has AF_INET at all.
#
# IPAddressDeny stays as the second layer — inert here, live in
# tests/e2e/egress-test.sh's system-scope application of these same
# units, and required by the static gate so that losing it is noticed.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes

[Install]
WantedBy=default.target
