# lisa-inferenced-dbus — session-bus surface dev.lisaos.Inference1
# (PLAN §5.1, Appendix A). Runs per-user alongside the hardened system
# service (lisa-inferenced.service): that one owns compute + the
# OpenAI-compat HTTP port and deliberately cannot reach the user's
# session bus (DynamicUser ≠ the login user's bus socket), so this
# companion gives the shell surfaces — assistant overlay (§5.7.1) and
# the launcher's "Ask Lisa" handoff (§5.7.2) — their engine surface.
# Same binary, same shared model store, loopback HTTP on 7778 (the
# system service owns 7777); the ledger it gates on is the user's own.
#
# Bus-loss behavior: the daemon exits when its D-Bus connection dies
# (watchdog in main.rs); Restart=on-failure puts the name back.

[Unit]
Description=Lisa inference session-bus surface (dev.lisaos.Inference1)

[Service]
Type=exec
# --config enables the BYO remote tier (ADR-0010/0015) so `remote:*` model
# hints route to the user's lisa-remoted broker over its session socket. This
# gives inferenced NO network access — it reaches a loopback unix socket; the
# broker owns egress, and the broker still gates every request on per-scope
# consent + a stored credential (nothing leaves by default, rule 5).
Environment=LISA_REMOTED_SOCKET=%t/lisa/remoted.sock
# --socket serves the same HTTP API on a unix socket, for callers that
# are forbidden IP sockets outright. lisa-contextd runs with
# RestrictAddressFamilies=AF_UNIX and IPAddressDeny=any, so it cannot
# reach :7778 to embed — the loopback port is still a network socket
# (#163). Spelled out rather than left to the daemon's default, so the
# path the context fabric depends on is visible in the unit that owns it.
ExecStart=/usr/bin/lisa-inferenced --dbus --bind 127.0.0.1:7778 --socket %t/lisa/inferenced.sock --engine llama --models-dir /var/lib/lisa-models/refs --config /usr/share/lisa/inferenced-remote.toml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
