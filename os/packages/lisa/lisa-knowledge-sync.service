[Unit]
Description=Index the OS knowledge pack into the context store (#175)
# After the companion so that when the embedding model is present the
# chunks embed in the same pass; without it they stay pending and the
# next boot after `lisa models get` picks them up (sync says which).
#
# `After=` orders START, not readiness — llama-server needs tens of
# seconds to load nomic-embed — so the sync retries a cold embedder with
# bounded backoff (6s at worst) and, if it is still not answering,
# leaves the chunks pending and exits 0. A boot that was too fast for
# the model is not a failure worth a red unit.
After=lisa-inferenced-dbus.service

[Service]
Type=oneshot
# The pack only changes when the OS does, and the sync hashes it before
# touching anything — so this is one hash comparison on every boot that
# follows an unchanged image.
ExecStart=/usr/bin/lisa context sync-knowledge
# 120s stays, and #192 is why it is now the right number rather than an
# accident. Measured on the reference device (image 20260803.66): the
# sync did its own work — hash, index 28 chunks, prune — in FIVE
# seconds, then hung for 115 more and was SIGTERM'd here, because the
# embed step was unscoped and inherited ~90,000 pending mail chunks
# from the #170 backfill. The embed is scoped to `system` now, so the
# runtime is a function of the pack (which ships in this image and is
# small) instead of whatever else the store happens to be carrying.
#
# What is left inside this budget, and it is now arithmetic rather than
# an estimate: 5s of hashing/indexing/pruning (measured), plus the
# embed step's worst case of 3 attempts x 30s socket timeout + (2+4)s
# of backoff = 96s. 101 of 120, with 19s spare.
#
# The 30s is `BOOT_REQUEST_TIMEOUT` in daemons/contextd/src/embed.rs,
# not the 180s default the mail backfill uses, precisely so that number
# fits here; `the_boot_profile_fits_inside_the_unit_timeout` asserts the
# sum against this line. Until that timeout existed, a POST to an
# inferenced that accepted the connection and then stalled had NO bound
# but this one — systemd killing the unit was the error report. It is
# now a backstop instead of the mechanism.
TimeoutStartSec=120

[Install]
# Session start, not a timer: retrieval should be ready before the
# person asks the assistant its first question, and the pack can only
# have changed if the image did — i.e. across a boot. Nothing is
# ordered after this unit, so a slow pass delays no other unit; it costs
# only its own place in the startup transaction.
WantedBy=default.target
