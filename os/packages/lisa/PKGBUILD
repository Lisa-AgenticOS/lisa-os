# Maintainer: Lisa OS project <https://github.com/Lisa-AgenticOS/lisa-os>
# Split package for the Lisa Layer (Track L, ADR-0003). Built from a
# git-archive tarball produced by os/repo-tools/build-packages.sh — the
# checksum is SKIP because the tarball is generated locally from git HEAD;
# the hosted repo (M1) ships signed packages instead (PLAN §5.10).

pkgbase=lisa
pkgname=(lisa-inferenced lisa-modeld lisa-cli lisa-shell lisa-portal lisa-agentd lisa-contextd lisa-notes lisa-remoted)
pkgver=0.1.0
pkgrel=1
pkgdesc="Lisa OS AI layer: local inference as a system service"
arch=(x86_64 aarch64)
url="https://github.com/Lisa-AgenticOS/lisa-os"
license=(GPL-2.0-only)
# glib2: glib-compile-schemas for the lisa-shell extension schema.
makedepends=(cargo glib2)
# makepkg's default lto option injects -flto into ring's C objects, which
# ld.lld cannot resolve at link time (cross-language LTO breakage).
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked
}

build() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo build --release --locked --workspace
}

check() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo test --release --locked --workspace
}

package_lisa-inferenced() {
    pkgdesc="Lisa OS model runtime & scheduler (PLAN §5.1)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-inferenced "$pkgdir/usr/bin/lisa-inferenced"
    install -Dm644 os/packages/lisa/lisa-inferenced.service \
        "$pkgdir/usr/lib/systemd/system/lisa-inferenced.service"
    # Per-user session-bus surface (dev.lisaos.Inference1) for the shell
    # surfaces; enabled for every user from first login.
    install -Dm644 os/packages/lisa/lisa-inferenced-dbus.service \
        "$pkgdir/usr/lib/systemd/user/lisa-inferenced-dbus.service"
    # Enables the BYO remote tier for the companion so `remote:*` chats reach
    # the broker (ADR-0015); referenced by the unit's --config.
    install -Dm644 os/packages/lisa/inferenced-remote.toml \
        "$pkgdir/usr/share/lisa/inferenced-remote.toml"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-inferenced-dbus.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-inferenced-dbus.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-modeld() {
    pkgdesc="Lisa OS model catalog & content-addressed store (PLAN §5.2)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-modeld "$pkgdir/usr/bin/lisa-modeld"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The daemon loop + D-Bus service land in M1; binary ships for
    # store/catalog operations via the lisa CLI meanwhile.
}

package_lisa-portal() {
    pkgdesc="Lisa OS trust-boundary portal (PLAN §5.5)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/xdg-desktop-portal-lisa \
        "$pkgdir/usr/bin/xdg-desktop-portal-lisa"
    install -Dm644 os/packages/lisa/xdg-desktop-portal-lisa.service \
        "$pkgdir/usr/lib/systemd/user/xdg-desktop-portal-lisa.service"
    install -Dm644 os/packages/lisa/dev.lisaos.Portal.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Portal.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-agentd() {
    pkgdesc="Lisa OS Agent Bus: MCP-native intents, tiers, undo (PLAN §5.4, ADR-0013)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-agentd "$pkgdir/usr/bin/lisa-agentd"
    # The agent loop (ADR-0025) ships with the bus: a machine with the
    # bus and no loop, or the reverse, is never a useful state.
    install -Dm755 target/release/lisa-harnessd "$pkgdir/usr/bin/lisa-harnessd"
    # Session-bus daemon, one per user, on from first login.
    install -Dm644 os/packages/lisa/lisa-agentd.service \
        "$pkgdir/usr/lib/systemd/user/lisa-agentd.service"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-agentd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-agentd.service"
    install -Dm644 os/packages/lisa/lisa-harnessd.service \
        "$pkgdir/usr/lib/systemd/user/lisa-harnessd.service"
    ln -s ../lisa-harnessd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-harnessd.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-contextd() {
    pkgdesc="Lisa OS context fabric: consented index + per-app memory over D-Bus (PLAN §5.3)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-contextd "$pkgdir/usr/bin/lisa-contextd"
    # Session-bus daemon (dev.lisaos.Context1), one per user, on from
    # first login. No network by design (CLAUDE.md rule 5) — the unit's
    # hardening removes the address families outright.
    install -Dm644 os/packages/lisa/lisa-contextd-user.service \
        "$pkgdir/usr/lib/systemd/user/lisa-contextd.service"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-contextd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-contextd.service"
    # D-Bus session activation — the overlay backend's first Search
    # auto-starts the daemon.
    install -Dm644 os/packages/lisa/dev.lisaos.Context1.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Context1.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

