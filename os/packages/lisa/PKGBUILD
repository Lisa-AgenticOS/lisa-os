# Maintainer: Lisa OS project <https://github.com/Lisa-AgenticOS/lisa-os>
# Split package for the Lisa Layer (Track L, ADR-0003). Built from a
# git-archive tarball produced by os/repo-tools/build-packages.sh — the
# checksum is SKIP because the tarball is generated locally from git HEAD;
# the hosted repo (M1) ships signed packages instead (PLAN §5.10).

pkgbase=lisa
pkgname=(lisa-inferenced lisa-modeld lisa-cli lisa-shell lisa-ime lisa-portal lisa-agentd lisa-contextd lisa-notes lisa-remoted)
pkgver=0.1.0
pkgrel=1
pkgdesc="Lisa OS AI layer: local inference as a system service"
arch=(x86_64 aarch64)
url="https://github.com/Lisa-AgenticOS/lisa-os"
license=(GPL-2.0-only)
# glib2: glib-compile-schemas for the lisa-shell extension schema.
# cmake + fcitx5: the lisa-ime addon (§5.7.3 layer 2, ADR-0007). fcitx5
# supplies Fcitx5Core/Fcitx5Utils and the Fcitx5ModuleDBus cmake config
# the double-tap-Shift summon links against.
makedepends=(cargo glib2 cmake fcitx5)
# makepkg's default lto option injects -flto into ring's C objects, which
# ld.lld cannot resolve at link time (cross-language LTO breakage).
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked
}

build() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo build --release --locked --workspace

    # The fcitx5 addon (§5.7.3 layer 2, ADR-0007). C++ rather than Rust
    # because it links Fcitx5Core directly; kept thin, with every model
    # decision daemon-side.
    cmake -S ime/fcitx5-lisa -B build-ime \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build-ime
}

check() {
    cd "$pkgbase-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo test --release --locked --workspace
    # The addon's fcitx5-free halves: the loopback HTTP client and the
    # double-tap-Shift state machine. Cheap, and the gesture is the kind
    # of thing that breaks silently — a detector that stops firing looks
    # exactly like a user pressing Shift wrong.
    ( cd build-ime && ctest --output-on-failure )
}

package_lisa-inferenced() {
    pkgdesc="Lisa OS model runtime & scheduler (PLAN §5.1)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-inferenced "$pkgdir/usr/bin/lisa-inferenced"
    install -Dm644 os/packages/lisa/lisa-inferenced.service \
        "$pkgdir/usr/lib/systemd/system/lisa-inferenced.service"
    # Per-user session-bus surface (dev.lisaos.Inference1) for the shell
    # surfaces; enabled for every user from first login.
    install -Dm644 os/packages/lisa/lisa-inferenced-dbus.service \
        "$pkgdir/usr/lib/systemd/user/lisa-inferenced-dbus.service"
    # Enables the BYO remote tier for the companion so `remote:*` chats reach
    # the broker (ADR-0015); referenced by the unit's --config.
    install -Dm644 os/packages/lisa/inferenced-remote.toml \
        "$pkgdir/usr/share/lisa/inferenced-remote.toml"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-inferenced-dbus.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-inferenced-dbus.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-modeld() {
    pkgdesc="Lisa OS model catalog & content-addressed store (PLAN §5.2)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-modeld "$pkgdir/usr/bin/lisa-modeld"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The daemon loop + D-Bus service land in M1; binary ships for
    # store/catalog operations via the lisa CLI meanwhile.
}

package_lisa-ime() {
    pkgdesc="Lisa OS input-method addon: writing tools + double-tap-Shift summon (PLAN §5.7.3 layer 2)"
    # fcitx5 is the runtime, not just a build dep: this is an addon
    # loaded into its process. lisa-inferenced does the proofreading —
    # the addon itself holds no model logic (ADR-0007).
    depends=(fcitx5 lisa-inferenced)
    # An input method reaches apps through toolkit modules. Without
    # these, fcitx5 runs and GTK/Qt apps never route a key to it, which
    # looks exactly like the addon being broken.
    optdepends=(
        'fcitx5-gtk: GTK2/3/4 apps'
        'fcitx5-qt: Qt5/6 apps'
        'fcitx5-configtool: change the trigger key or turn the gesture off'
    )
    cd "$pkgbase-$pkgver"
    DESTDIR="$pkgdir" cmake --install build-ime
    # Quiet boots (#191): hide fcitx5's once-per-boot "install the
    # kimpanel extension" tip on GNOME Wayland. See the file's header;
    # a user's own notifications.conf overrides this wholesale.
    install -Dm644 ime/fcitx5-lisa/notifications.conf \
        "$pkgdir/etc/xdg/fcitx5/conf/notifications.conf"

    # Make fcitx5 start with the session and be the input method GTK/Qt
    # apps talk to. Shipping the addon without this produces the worst
    # kind of "installed but does nothing": every file present, the
    # gesture dead, and nothing logged to explain it.
    install -Dm644 os/packages/lisa/lisa-ime.sh \
        "$pkgdir/etc/profile.d/lisa-ime.sh"
    install -Dm644 os/packages/lisa/fcitx5-lisa-autostart.desktop \
        "$pkgdir/etc/xdg/autostart/fcitx5-lisa.desktop"
}

