    pkgdesc="Lisa Notes: first-party MCP tool provider on the Agent Bus (ADR-0013)"
    depends=(gcc-libs lisa-agentd)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-notes "$pkgdir/usr/bin/lisa-notes"
