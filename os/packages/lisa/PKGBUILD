package_lisa-cli() {
    pkgdesc="Lisa OS command center CLI (lisa ask, lisa models, ...)"
    depends=(gcc-libs)
    # No Flutter optdepends (ADR-0047 §3, issue #246). They advertised a
    # build toolchain — clang/cmake/ninja/pkgconf/gtk3 plus git for the
    # aarch64 SDK — for `lisa forge --build`, which builds the PARKED
    # lane. A Lisa app is GJS + GTK4/Adwaita: interpreted source with no
    # build step, so the app road needs none of them, and listing them
    # here told every reader of `pacman -Si lisa-cli` that Flutter is how
    # you build for this system. Anyone using the parked lane installs
    # its toolchain themselves; `lisa forge --setup` no longer touches
    # /var and no longer needs sudo (#243).
    cd "$pkgbase-$pkgver"
    # The CLI itself lives under /usr/lib (the image's floor copy) and
    # /usr/bin/lisa is a resolver that prefers the runtime channel, so a
    # CLI fix ships without an OS release or a reboot (issue #52). The
    # resolver falls back here unconditionally, and LISA_NO_CHANNEL=1
    # forces it — `lisa update` must keep working when a channel build is
    # bad, because it is how the device gets fixed.
    install -Dm755 target/release/lisa "$pkgdir/usr/lib/lisa/bin/lisa"
    install -Dm755 os/packages/lisa/lisa-resolver "$pkgdir/usr/bin/lisa"
    # App launcher indirection (ADR-0020): prefers the updated apps tree on
    # /var over the baked /usr/share/lisa/shell.
    install -Dm755 os/packages/lisa/lisa-app "$pkgdir/usr/bin/lisa-app"
    # Payload sync (ADR-0023 phase 1): pulls what the image stopped
    # carrying — the Zen browser — onto /var once the machine is online.
    # Enabled in the image by mkosi.postinst.chroot; on Track L the admin
    # enables the timer (`systemctl enable --now lisa-apps-sync.timer`).
    # …and the directories those payloads land in. The SAME file the
    # image ships, not a copy: 2775 root:lisa is what lets the desktop
    # user install into a tree root the system service created first
    # (#239 defect 4, ADR-0034 §7b). Without it Track L has no
    # /var/lib/lisa-apps at all and the first `lisa apps update` creates
    # one owned by whoever ran it.
    install -Dm644 os/mkosi/mkosi.extra/usr/lib/tmpfiles.d/lisa-apps.conf \
        "$pkgdir/usr/lib/tmpfiles.d/lisa-apps.conf"
    install -Dm644 os/packages/lisa/lisa-apps-sync.service \
        "$pkgdir/usr/lib/systemd/system/lisa-apps-sync.service"
    install -Dm644 os/packages/lisa/lisa-apps-sync.timer \
        "$pkgdir/usr/lib/systemd/system/lisa-apps-sync.timer"
    # Mail sync (issue #155). USER units: the Maildir is under $HOME and
    # the OAuth token comes from the user session's Online Accounts, so
    # a system service would have neither. Shipped disabled and enabled
    # by `lisa mail setup` — a timer that fires every five minutes to
    # report "no config" is a recurring failure for a feature its owner
    # never asked for.
    install -Dm644 os/packages/lisa/lisa-mail-sync.service \
        "$pkgdir/usr/lib/systemd/user/lisa-mail-sync.service"
    install -Dm644 os/packages/lisa/lisa-mail-sync.timer \
        "$pkgdir/usr/lib/systemd/user/lisa-mail-sync.timer"
    # A rescue shell the owner can actually reach (issue #23). Both
    # units, because emergency.service is where a failed boot lands and
    # rescue.service is where `systemctl rescue` goes — a recovery path
    # that works from only one of them is one a person finds by luck.
    for unit in emergency rescue; do
        install -Dm644 os/packages/lisa/emergency-force-sulogin.conf \
            "$pkgdir/usr/lib/systemd/system/$unit.service.d/10-lisa-force-sulogin.conf"
    done
    # Terminal integration (PLAN §5.8): opt-in shell hooks for
    # `lisa explain` / `lisa suggest` (Ctrl+G review gate). All logic is
    # in the CLI; these only wire keys and prompts (CLAUDE.md rule 4).
    install -Dm644 apps/terminal-integration/lisa-terminal.zsh \
        "$pkgdir/usr/share/lisa/terminal/lisa-terminal.zsh"
    install -Dm644 apps/terminal-integration/lisa-terminal.bash \
        "$pkgdir/usr/share/lisa/terminal/lisa-terminal.bash"
    # Inert gate: sources nothing unless the user set LISA_TERMINAL=1.
    install -Dm644 apps/terminal-integration/lisa-terminal.sh \
        "$pkgdir/etc/profile.d/lisa-terminal.sh"
    # Shell completions, generated by the binary we just built
    # (`lisa completions <shell>`) into each shell's standard path.
    install -d "$pkgdir/usr/share/bash-completion/completions" \
        "$pkgdir/usr/share/zsh/site-functions" \
        "$pkgdir/usr/share/fish/vendor_completions.d"
    target/release/lisa completions bash \
        > "$pkgdir/usr/share/bash-completion/completions/lisa"
    target/release/lisa completions zsh \
        > "$pkgdir/usr/share/zsh/site-functions/_lisa"
    target/release/lisa completions fish \
        > "$pkgdir/usr/share/fish/vendor_completions.d/lisa.fish"
    # No lisa_ui payload (ADR-0047 §3, issue #246). This installed four
    # parked `.dart` files to /usr/share/lisa/lisa_ui on every device so
    # that `lisa forge --flutter` could scaffold against them. #37 —
    # ship the Flutter lane on-device — is closed WON'T-DO, and shipping
    # a kit for a lane with no app is payload nobody uses. `--flutter`
    # still works for anyone who wants it: set LISA_UI_PATH to a
    # checkout.
    # Skills: SKILL.md workflows the harness loads on demand (ADR-0025).
    # `lisa skills` resolves $LISA_SKILLS_DIR → ~/.local/share/lisa/skills →
    # here, so a user skill shadows a packaged one.
    install -d "$pkgdir/usr/share/lisa/skills"
    cp -r skills/. "$pkgdir/usr/share/lisa/skills/"
    # The OS knowledge pack (#175, ADR-0040): generated from component
    # READMEs, indexed under the `system` provenance by
    # `lisa context sync-knowledge`, retrieved when the model is asked
    # about the OS it runs on. Rides lisa-cli because the CLI is its
    # only consumer today.
    install -d "$pkgdir/usr/share/lisa/knowledge"
    cp -r docs/knowledge/. "$pkgdir/usr/share/lisa/knowledge/"
    # Sync it into the per-user context store at session start; a boot
    # on an unchanged image is one hash comparison and done.
    install -Dm644 os/packages/lisa/lisa-knowledge-sync.service \
        "$pkgdir/usr/lib/systemd/user/lisa-knowledge-sync.service"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-knowledge-sync.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-knowledge-sync.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-shell() {
    pkgdesc="Lisa OS shell surfaces: assistant overlay, semantic launcher, Ledger app, AI settings (PLAN §5.7, §5.11)"
    # Pure GJS — no compiled code, so one package serves every arch.
    arch=(any)
    # gjs runs the overlay backend + Ledger app; libadwaita (pulls gtk4)
    # renders the Ledger app; lisa-cli is how surfaces reach the
    # substrate (context search, ledger reads — CLAUDE.md rule 7);
    # libqalculate ships qalc, the launcher's calculator lane (§5.7.2:
    # math routes to qalc, never the model).
    # poppler-glib renders Preview's PDFs and qpdf applies its page
    # reordering — NAMED here, not inherited transitively, so Track L
    # installs carry them too (#199, the ADR-0034 lesson: a capability
    # that arrives as someone else's accident disappears the same way).
    depends=(gjs libadwaita lisa-cli libqalculate poppler-glib qpdf)
    # `gnome-shell` is the *name*, not necessarily the stock package:
    # the image installs lisa-desktop-shell, which provides=(gnome-shell)
    # and replaces it (ADR-0038/0048). Either satisfies this, which is
    # the point of naming the provide rather than the package — Track L
    # layers onto somebody's own Arch install and must not care which
    # shell is there.
    #
    # The three extensions install to /usr/share/gnome-shell/extensions
    # and are enabled by 10_lisa-shell.gschema.override below. Both of
    # those reach a Lisa Desktop shell because it installs at /usr:
    # extensions are found through XDG_DATA_DIRS
    # (js/misc/fileUtils.js collectFromDatadirs), and the override is
    # compiled into the same /usr/share/glib-2.0/schemas the shell
    # reads. A private-prefix shell would have found the files and
    # ignored the override — see ADR-0038 and the lisa-desktop PKGBUILD.
    optdepends=('gnome-shell: overlay + launcher Shell extensions (GNOME 46+)')
    cd "$pkgbase-$pkgver"

    # Surface trees under /usr/share/lisa/shell — the path the D-Bus
    # activation file and the desktop entry already reference.
    local share="$pkgdir/usr/share/lisa/shell"
    # The SAME staging script release.yml packs lisa-apps_<ver>.tar.zst
    # from. Composing this tree here by hand is how the image came to
    # carry Mail, Surfer and Preview while the update channel did not
    # (#239 defect 2) — the two lists were one file apart and nothing
    # compared them. What goes in the tree, and what is excluded from it,
    # is decided in one place now.
    bash os/repo-tools/build-apps-payload.sh "$share"
    # Compile every extension's keybinding schema in place so its
    # getSettings() resolves from its own schemas/ directory. A LOOP,
    # not a list: the overlay was named here by hand, so when the
    # launcher grew a schema of its own (#255) there was nothing to
    # make the second one compile — and an extension whose getSettings()
    # throws does not degrade, it fails to enable at all.
    for schemadir in "$share"/*/schemas; do
        [ -d "$schemadir" ] || continue
        glib-compile-schemas "$schemadir"
    done

    # GNOME Shell loads system extensions from
    # /usr/share/gnome-shell/extensions/<uuid>; symlinks keep
    # /usr/share/lisa/shell the single install location.
    install -d "$pkgdir/usr/share/gnome-shell/extensions"
    ln -s /usr/share/lisa/shell/overlay-extension \
        "$pkgdir/usr/share/gnome-shell/extensions/lisa-overlay@lisa-os.org"
    ln -s /usr/share/lisa/shell/launcher \
        "$pkgdir/usr/share/gnome-shell/extensions/lisa-launcher@lisa-os.org"
    ln -s /usr/share/lisa/shell/desktop \
        "$pkgdir/usr/share/gnome-shell/extensions/lisa-desktop@lisa-os.org"

    # D-Bus activation for the headless overlay backend (§5.7.1).
    install -Dm644 shell/overlay-extension/backend/dev.lisaos.Overlay1.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Overlay1.service"
    # Push-to-talk capture (§5.7.5). The same process owns this name,
    # but activation is per-name: without this file the first key press
    # finds nobody on dev.lisaos.Voice1, and voice appears to work only
    # when something else started the backend first.
    install -Dm644 shell/overlay-extension/backend/dev.lisaos.Voice1.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Voice1.service"
    # The consent surface (issue #145, ADR-0035 §4). agentd trusts
    # whoever owns dev.lisaos.Consent1 to answer for the human, and
    # refuses a Modal approval from the peer that made the request. Until
    # this file exists on a device that check has nothing to point at:
    # the name is unowned, every confirmation lands in the Absent branch,
    # and the requester answers its own call. That is the availability
    # fallback, not the safety property — and it is the third time a
    # component has been built, packaged and left out of the image
    # (lisa-portal was #153).
    install -Dm644 shell/consent/dev.lisaos.Consent1.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Consent1.service"
    # Ledger app launcher entry (§5.7.6).
    install -Dm644 shell/ledger-app/app.lisaos.LedgerApp.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.LedgerApp.desktop"
    # Assistant chat window: launcher entry + its spark icon (ADR-0015).
    install -Dm644 apps/preview/app.lisaos.Preview.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.Preview.desktop"
    # The manifest goes where agentd looks and nowhere else: it read only
    # /usr/share/lisa/manifests all along, so the four tools Preview
    # declares had never once reached the model (#241).
    install -Dm644 apps/preview/app.lisaos.Preview.json \
        "$pkgdir/usr/share/lisa/manifests/app.lisaos.Preview.json"
    # The quick-look app id (NoDisplay): Space runs Preview under
    # app.lisaos.PreviewPeek so the desktop can keep peeks out of the
    # dock; this file is how the shell resolves that id to an icon.
    install -Dm644 apps/preview/app.lisaos.PreviewPeek.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.PreviewPeek.desktop"
    # Space-to-preview in Files: Nautilus dials the VERSIONLESS name
    # (the 2 is only in the interface — nautilus 50.2.2
    # src/nautilus-previewer.c:43) and ping-gates it at startup, so
    # owning the wrong name means Space is dropped silently. The old
    # org.gnome.NautilusPreviewer2.service shipped in ≤20260803.68 is
    # dead weight the image replaces wholesale on update.
    install -Dm644 apps/preview/org.gnome.NautilusPreviewer.service \
        "$pkgdir/usr/share/dbus-1/services/org.gnome.NautilusPreviewer.service"
    install -Dm644 apps/surfer/app.lisaos.Surfer.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.Surfer.desktop"
    install -Dm644 apps/surfer/app.lisaos.Surfer.json \
        "$pkgdir/usr/share/lisa/manifests/app.lisaos.Surfer.json"
    install -Dm644 apps/mail/app.lisaos.Mail.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.Mail.desktop"
    install -Dm644 apps/mail/app.lisaos.Mail.json \
        "$pkgdir/usr/share/lisa/manifests/app.lisaos.Mail.json"
    install -Dm644 shell/assistant/app.lisaos.Assistant.desktop \
        "$pkgdir/usr/share/applications/app.lisaos.Assistant.desktop"
    # D-Bus activation (#210): the Spotlight hand-off calls `ask` on
    # this name from the launcher and the overlay, and without the
    # service file that call fails whenever the app is closed — which
    # is exactly when a new conversation is being started.
    install -Dm644 shell/assistant/app.lisaos.Assistant.service \
        "$pkgdir/usr/share/dbus-1/services/app.lisaos.Assistant.service"
    install -Dm644 shell/assistant/lisa-assistant-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/lisa-assistant-symbolic.svg"
    # App icons. Surfer wears the robot-surfer artwork (user-chosen,
    # 2026-08-03), squircle-masked at the brand corner radius — TWO
    # states: meditating on flat water when closed, riding the wave
    # while running. The -active variant is the opt-in the desktop
    # extension looks for (#190, shell/desktop lib/stateicon.js). The
    # token-violet SVG stays in apps/surfer/icons/ as the source for a
    # future symbolic variant. Mail keeps the violet family.
    install -Dm644 apps/surfer/icons/app.lisaos.Surfer.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/app.lisaos.Surfer.png"
    install -Dm644 apps/surfer/icons/app.lisaos.Surfer-active.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/app.lisaos.Surfer-active.png"
    install -Dm644 apps/mail/icons/app.lisaos.Mail.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/app.lisaos.Mail.svg"
    # AI settings launcher entry (§5.11). Also the target the native
    # gnome-control-center Intelligence panel opens for provider/key
    # management (ADR-0012) — it resolves this desktop id.
    # Session defaults: extensions enabled; Super+Space is the
    # Spotlight-style search (§5.7.2), Super+Shift+Space the assistant
    # overlay (§5.7.1), the input-source switcher moves to
    # Ctrl+Super+Space. glib2's pacman hook folds this into the
    # compiled system schemas on install.
    install -Dm644 os/packages/lisa/10_lisa-shell.gschema.override \
        "$pkgdir/usr/share/glib-2.0/schemas/10_lisa-shell.gschema.override"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
