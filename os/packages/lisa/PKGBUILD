}

package_lisa-agentd() {
    pkgdesc="Lisa OS Agent Bus: MCP-native intents, tiers, undo (PLAN §5.4, ADR-0013)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-agentd "$pkgdir/usr/bin/lisa-agentd"
    # The agent loop (ADR-0025) ships with the bus: a machine with the
    # bus and no loop, or the reverse, is never a useful state.
    install -Dm755 target/release/lisa-harnessd "$pkgdir/usr/bin/lisa-harnessd"
    # Session-bus daemon, one per user, on from first login.
    install -Dm644 os/packages/lisa/lisa-agentd.service \
        "$pkgdir/usr/lib/systemd/user/lisa-agentd.service"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-agentd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-agentd.service"
    install -Dm644 os/packages/lisa/lisa-harnessd.service \
        "$pkgdir/usr/lib/systemd/user/lisa-harnessd.service"
    ln -s ../lisa-harnessd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-harnessd.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_lisa-contextd() {
    pkgdesc="Lisa OS context fabric: consented index + per-app memory over D-Bus (PLAN §5.3)"
    depends=(gcc-libs)
    cd "$pkgbase-$pkgver"
    install -Dm755 target/release/lisa-contextd "$pkgdir/usr/bin/lisa-contextd"
    # Session-bus daemon (dev.lisaos.Context1), one per user, on from
    # first login. No network by design (CLAUDE.md rule 5) — the unit's
    # hardening removes the address families outright.
    install -Dm644 os/packages/lisa/lisa-contextd-user.service \
        "$pkgdir/usr/lib/systemd/user/lisa-contextd.service"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../lisa-contextd.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/lisa-contextd.service"
    # D-Bus session activation — the overlay backend's first Search
    # auto-starts the daemon.
    install -Dm644 os/packages/lisa/dev.lisaos.Context1.service \
        "$pkgdir/usr/share/dbus-1/services/dev.lisaos.Context1.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

