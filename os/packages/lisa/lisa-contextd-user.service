# Per-user context fabric (dev.lisaos.Context1 on the session bus,
# PLAN §5.3): scoped/hybrid search over the user's consented index and
# per-app durable memory, every retrieval ledgered before results
# return (dataflow rule 4). The store is the same per-user SQLite file
# `lisa context` uses, so CLI and daemon always agree.
#
# No network — ever (CLAUDE.md rule 5): the surface is D-Bus and the
# data is local SQLite; the hardening below removes the address
# families outright so no dependency can quietly add egress.
#
# Bus-loss behavior: the daemon exits when its D-Bus connection dies
# (watchdog in main.rs); Restart=on-failure puts the name back.
[Unit]
Description=Lisa context fabric (dev.lisaos.Context1)
After=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/lisa-contextd
Restart=on-failure
RestartSec=2
# No-egress hardening: D-Bus + local files only.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
UMask=0077

[Install]
WantedBy=default.target
