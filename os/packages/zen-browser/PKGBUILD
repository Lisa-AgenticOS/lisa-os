# Zen browser — a calm, Firefox-based browser (user request, 2026-07-23).
# Repackages the upstream release tarball (no compilation). Each sha256 is
# the pinned GitHub release-asset digest — a re-uploaded/tampered asset
# fails the build (HTTPS + a version tag alone is not integrity).
#
# SPLIT, ADR-0023 phase 1 / issue #51. Two packages out of one recipe:
#
#   zen-browser-launcher — ~10 KiB: /usr/bin/zen-browser (a resolver, see
#       zen-browser.sh), the .desktop entry and the hicolor icons. This is
#       OS contract and STAYS IN THE IMAGE forever, so the launcher entry
#       and the `zen-browser` command exist on every Lisa system whether or
#       not the browser payload happens to be present. Without it, dropping
#       the payload from the image would take the app-grid entry with it.
#
#   zen-browser — ~363 MiB (x86_64) / ~328 MiB (aarch64) of /opt/zen. This
#       is the payload that LEAVES the image: the same tree is published as
#       lisa-zen_<ver>_<arch>.tar.zst on the apps channel by
#       os/repo-tools/build-zen-payload.sh and installed under
#       /var/lib/lisa/apps/payloads/zen by `lisa apps sync`. It is still in
#       the release image for ONE overlap release so that devices which
#       already have Zen baked into their root never boot a slot without a
#       browser — see release.yml's Packages= block for the removal cue.
#
# aarch64 (ADR-0021, issue #28): upstream DOES ship a Linux arm64 build.
# The 1.21.8b release carries `zen.linux-aarch64.tar.xz` alongside the
# x86_64 one; the digest below was taken by downloading that exact asset
# (2026-07-25), not guessed — the same download also confirmed it unpacks
# to the same top-level `zen/` dir, that `zen/zen` is an aarch64 ELF, and
# that the icon path the .desktop below points at exists in it. The
# x86_64 digest re-verified byte-identical to the one already pinned here,
# which is what makes the arm64 one trustworthy. ADR-0021's original
# "no aarch64 artifact — exclude it" line was an assumption, now corrected
# there. Both runtime deps (gtk3, nss, …) exist on Arch Linux ARM.
# Both pins re-verified by download on 2026-07-26 (issue #51) — unchanged.
pkgbase=zen-browser
pkgname=(zen-browser-launcher zen-browser)
pkgver=1.21.8b
pkgrel=2
pkgdesc="Zen — a calm, Firefox-based browser"
arch=(x86_64 aarch64)
url="https://zen-browser.app"
license=(MPL-2.0)
options=(!strip !debug)
# The launcher script is a file in this repo, not a fetched artifact — SKIP
# is about local provenance, not a waived external digest (CLAUDE.md rule 8
# governs the two pinned URLs below, which are NOT skipped).
source=(zen-browser.sh)
sha256sums=('SKIP')
source_x86_64=("zen-${pkgver}-x86_64.tar.xz::https://github.com/zen-browser/desktop/releases/download/${pkgver}/zen.linux-x86_64.tar.xz")
sha256sums_x86_64=('05a36657e4c9dbe700e54a2e3941f7af4656abbe330690aa74d8cf793af396f4')
source_aarch64=("zen-${pkgver}-aarch64.tar.xz::https://github.com/zen-browser/desktop/releases/download/${pkgver}/zen.linux-aarch64.tar.xz")
sha256sums_aarch64=('0586ff279d7a1f93207fdb195c5586ef0d6813bd4f4318badcd0984adc39db39')

package_zen-browser-launcher() {
  pkgdesc="Zen browser launcher entry and payload resolver (image side of ADR-0023 phase 1)"
  # libnotify: the resolver's only way to tell a user launching from the app
  # grid *why* nothing opened and what to run. A .desktop launch has no
  # terminal, so stderr alone would be a silent failure.
  depends=(libnotify)
  optdepends=('zen-browser: the browser payload baked into the image'
              'lisa-cli: fetch the browser payload with `lisa apps sync`')

  install -Dm755 "$srcdir/zen-browser.sh" "$pkgdir/usr/bin/zen-browser"

  # Icons come out of the verified tarball rather than being invented here
  # (CLAUDE.md rule 8), and land in hicolor so the entry keeps its icon once
  # /opt/zen is gone — an absolute Icon= path into the payload would break
  # the moment the payload moved to /var. The five PNGs are byte-identical
  # between the x86_64 and aarch64 tarballs (verified 2026-07-26), so this
  # package's content does not actually vary by arch.
  for px in 16 32 48 64 128; do
    install -Dm644 "$srcdir/zen/browser/chrome/icons/default/default${px}.png" \
      "$pkgdir/usr/share/icons/hicolor/${px}x${px}/apps/zen-browser.png"
  done

  # Launcher entry (the tarball ships no .desktop). Exec goes through the
  # resolver and Icon is a theme name — neither mentions where the payload
  # lives, which is the point.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/zen-browser.desktop" <<'EOF'
[Desktop Entry]
Name=Zen Browser
GenericName=Web Browser
Comment=Browse the web calmly
Exec=/usr/bin/zen-browser %U
Icon=zen-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=zen
EOF
}

package_zen-browser() {
  pkgdesc="Zen — a calm, Firefox-based browser (image-baked payload)"
  depends=(zen-browser-launcher gtk3 libxt mailcap nss)
  optdepends=('ffmpeg: video and audio playback')
  # The tarball unpacks to a top-level `zen/` dir. This tree — and nothing
  # else — is what the apps-channel payload carries.
  install -d "$pkgdir/opt"
  cp -a "$srcdir/zen" "$pkgdir/opt/zen"
}
