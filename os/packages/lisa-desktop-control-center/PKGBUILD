# gnome-control-center, Lisa build — stock upstream (pinned 50.4) plus a
# native "Intelligence" panel (ADR-0012). Derived from Arch's
# gnome-control-center PKGBUILD (50.4-1); the ONLY delta is the panel dir
# + two anchored edits applied in prepare(). Re-pinning to a new GNOME
# release: bump pkgver, rebuild, and fix the two anchors if upstream moved
# them (the guards below fail loudly if so).
#
# Built in CI / a container (arch), never on the macOS dev host. Our
# package repo is layered above [extra] so this build wins over stock.
#
# aarch64 (ADR-0021, issue #28): no per-arch delta. Arch Linux ARM builds
# stock gnome-control-center for aarch64 itself — so upstream is known to
# compile there, every depends/makedepends entry below resolves on ALARM
# (checked against mirror.archlinuxarm.org's core/extra DBs, 2026-07-25),
# and the Lisa delta (a C panel + two anchored sed edits + a blueprint
# removal) is architecture-independent. Nothing here depends on
# outranking ALARM by pkgrel any more: this package has its own name and
# carries provides/conflicts/replaces, so stock cannot co-install at any
# version and the swap is by contract (#284).

pkgbase=gnome-control-center
# lisa-desktop-*: the fork-family prefix (lisa-desktop-shell set the
# pattern). The packages used to TAKE the stock names and win by
# pkgrel — which loses silently the day Arch ships a higher pkgver
# (50.4 shipped 2026-08-04 and would have outranked this on any
# Track L machine). provides/conflicts replaces that race: stock can
# never be co-installed, whatever its version, and anything depending
# on the stock names is satisfied by provides=.
pkgname=(
  lisa-desktop-control-center
  lisa-desktop-keybindings
)
pkgver=50.4
pkgrel=1
pkgdesc="GNOME's main interface to configure various aspects of the desktop (Lisa build: + Intelligence panel, OS updates in System)"
url="https://apps.gnome.org/Settings/"
license=(GPL-2.0-or-later)
arch=(x86_64 aarch64)
depends=(
  accountsservice bolt cairo colord-gtk4 cups-pk-helper dconf fontconfig
  gcr-4 gdk-pixbuf2 glib2 glibc gnome-bluetooth-3.0 gnome-color-manager
  gnome-desktop-4 gnome-online-accounts gnome-settings-daemon gnome-shell
  gnutls graphene gsettings-desktop-schemas gsound gst-plugins-good gtk4
  hicolor-icon-theme json-glib krb5 libadwaita libcolord libcups libepoxy
  libgcc libgoa libgtop libgudev libibus libmalcontent libmm-glib libnm
  libnma-gtk4 libpulse libpwquality libsecret libsoup3 libwacom libx11
  libxi libxml2 pango polkit smbclient sound-theme-freedesktop tecla
  udisks2 upower wayland
)
makedepends=(
  blueprint-compiler docbook-xsl git glib2-devel meson modemmanager
)
checkdepends=(
  python-dbusmock python-gobject xorg-server-xvfb
)
# The panel sources live beside this PKGBUILD (makepkg resolves local
# sources by basename in $startdir — no subdirs).
source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-control-center.git?signed#tag=${pkgver/[a-z]/.&}"
  "git+https://gitlab.gnome.org/GNOME/libgnome-volume-control.git"
  "git+https://gitlab.gnome.org/GNOME/libgxdp.git#commit=1fe6de799f39b3126e8d0db66fa4f16c10fd9bd6"
  "cc-lisa-panel.h"
  "cc-lisa-panel.c"
  "cc-lisa-panel-meson.build"
  "gnome-lisa-panel.desktop.in"
  "lisa-intelligence-symbolic.svg"
  "cc-system-updates-lisa.h"
  "cc-system-updates-lisa.c"
)
b2sums=('94d45dc219e1f1e533d66e2cc9ce5daadc8030ccc2466befc7ad3f79ea8fa8928648878c4caf8b0170ea345b8a1bf3d11e14237e37175fa15f97a7fc7d92dde7'
        'SKIP'
        'a67bd121284dd5546607f21a966ae7e73a05b5cd5e90d925fa0ba710e7c877f85a7c700dded0e050ce297884201f07177cd975c5501cc62fe35c27e5285bdfa3'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP')
validpgpkeys=(
  9B60FE7947F0A3C58136817F2C2A218742E016BE # Felipe Borges (GNOME) <felipeborges@gnome.org>
)

prepare() {
  cd $pkgbase

  git submodule init
  git submodule set-url subprojects/gvc "$srcdir/libgnome-volume-control"
  git -c protocol.file.allow=always -c protocol.allow=never submodule update

  # --- Lisa delta (ADR-0012) ---------------------------------------
  # Guard the anchors: a GNOME bump that moved them must fail loudly,
  # not silently drop our panel.
  grep -q '^extern GType cc_wellbeing_panel_get_type (void);' shell/cc-panel-loader.c \
    || { echo "cc-panel-loader.c extern anchor moved — update the Lisa patch" >&2; return 1; }
  grep -q 'PANEL_TYPE("wellbeing",' shell/cc-panel-loader.c \
    || { echo "cc-panel-loader.c PANEL_TYPE anchor moved — update the Lisa patch" >&2; return 1; }
  grep -q "^  'wellbeing'," panels/meson.build \
    || { echo "panels/meson.build anchor moved — update the Lisa patch" >&2; return 1; }

  # Drop in the panel.
  install -d panels/lisa
  install -m644 "$srcdir"/cc-lisa-panel.h            panels/lisa/cc-lisa-panel.h
  install -m644 "$srcdir"/cc-lisa-panel.c            panels/lisa/cc-lisa-panel.c
  install -m644 "$srcdir"/cc-lisa-panel-meson.build  panels/lisa/meson.build
  install -m644 "$srcdir"/gnome-lisa-panel.desktop.in \
    panels/lisa/gnome-lisa-panel.desktop.in
  install -m644 "$srcdir"/lisa-intelligence-symbolic.svg \
    panels/lisa/lisa-intelligence-symbolic.svg

  # Regression guard (ADR-0012): X-GNOME-SystemSettings in the panel
  # .desktop makes GNOME 50 treat `lisa` as a `system` subpage — the
  # sidebar row shows but activating it redirects to `system lisa` and
  # dies with "Invalid subpage: 'lisa'". Must stay a top-level category.
  # Check the Categories= line only — the file's comment mentions the bad
  # token deliberately, and must not trip the guard.
  grep '^Categories=' panels/lisa/gnome-lisa-panel.desktop.in \
    | grep -q 'X-GNOME-PersonalizationSettings' \
    || { echo "lisa panel .desktop must use a top-level category, not SystemSettings" >&2; return 1; }
  ! grep '^Categories=' panels/lisa/gnome-lisa-panel.desktop.in \
    | grep -q 'X-GNOME-SystemSettings' \
    || { echo "lisa panel .desktop has X-GNOME-SystemSettings — breaks activation (ADR-0012)" >&2; return 1; }

  # --- Remove the "Support GNOME" donate group from About (ADR-0012) ----
  # Lisa is a derived distro; soliciting donations to GNOME from the OS
  # About page is upstream's business, not ours. Anchored + guarded: a
  # GNOME bump that moves the blp fails the build loudly instead of
  # silently keeping (or half-removing) the group.
  local about_blp=panels/system/about/cc-about-page.blp
  grep -q 'Support GNOME' "$about_blp" \
    || { echo "donate anchor moved in $about_blp — update the Lisa patch" >&2; return 1; }
  # Delete the smallest brace-balanced Adw.PreferencesGroup block that
  # contains the donate anchor.
  awk '
    BEGIN { buf = ""; ingroup = 0; depth = 0 }
    /Adw\.PreferencesGroup/ && !ingroup { ingroup = 1; buf = $0 "\n"; depth = gsub(/{/, "{") - gsub(/}/, "}"); next }
    ingroup {
      buf = buf $0 "\n"
      depth += gsub(/{/, "{") - gsub(/}/, "}")
      if (depth <= 0) {
        if (buf !~ /Support GNOME/) printf "%s", buf
        ingroup = 0; buf = ""
      }
      next
    }
    { print }
  ' "$about_blp" > "$about_blp.lisa" && mv "$about_blp.lisa" "$about_blp"
  ! grep -q 'Support GNOME' "$about_blp" \
    || { echo "donate group removal failed in $about_blp" >&2; return 1; }

  # --- Lisa OS updates row in System (ADR-0018) -------------------------
  # GNOME 50 reserves a "Software Updates" group on the System page but
  # only shows it when gnome-software or gpk-update-viewer is installed,
  # and its row spawns one of those two binaries. Lisa ships neither —
  # OS updates are A/B image swaps through systemd-sysupdate. So the
  # System page answered neither "what am I running" nor "is there
  # anything newer". We claim the group instead of adding a second one.
  local sys_c=panels/system/cc-system-panel.c
  local sys_blp=panels/system/cc-system-panel.blp
  local sys_meson=panels/system/meson.build
  grep -q 'Adw.PreferencesGroup software_updates_group {' "$sys_blp" \
    || { echo "software_updates_group anchor moved in $sys_blp — update the Lisa patch" >&2; return 1; }
  grep -q '^show_software_updates_group (CcSystemPanel \*self)$' "$sys_c" \
    || { echo "show_software_updates_group anchor moved in $sys_c — update the Lisa patch" >&2; return 1; }
  grep -q 'gtk_widget_set_visible (GTK_WIDGET (self->software_updates_group), show_software_updates_group (self));' "$sys_c" \
    || { echo "software_updates_group visibility anchor moved in $sys_c — update the Lisa patch" >&2; return 1; }
  grep -q "^  'cc-system-panel.c',\$" "$sys_meson" \
    || { echo "sources anchor moved in $sys_meson — update the Lisa patch" >&2; return 1; }

  install -m644 "$srcdir"/cc-system-updates-lisa.c panels/system/cc-system-updates-lisa.c
  install -m644 "$srcdir"/cc-system-updates-lisa.h panels/system/cc-system-updates-lisa.h
  sed -i "s/^  'cc-system-panel.c',\$/  'cc-system-panel.c',\n  'cc-system-updates-lisa.c',/" \
    "$sys_meson"

  # Strip GNOME's gnome-software row, keeping the group and its id so the
  # template child binding in cc-system-panel.c still resolves. Our row
  # is added to it at runtime by lisa_system_updates_attach().
  awk '
    BEGIN { ingroup = 0; depth = 0 }
    /Adw\.PreferencesGroup software_updates_group \{/ && !ingroup {
      ingroup = 1
      depth = gsub(/\{/, "{") - gsub(/\}/, "}")
      print "        Adw.PreferencesGroup software_updates_group {"
      print "          visible: false;"
      print "        }"
      next
    }
    ingroup {
      depth += gsub(/\{/, "{") - gsub(/\}/, "}")
      if (depth <= 0) ingroup = 0
      next
    }
    { print }
  ' "$sys_blp" > "$sys_blp.lisa" && mv "$sys_blp.lisa" "$sys_blp"
  ! grep -q 'gnome-software\|adw-external-link-symbolic' "$sys_blp" \
    || { echo "gnome-software row still present in $sys_blp" >&2; return 1; }
  grep -q 'software_updates_group' "$sys_blp" \
    || { echo "software_updates_group id lost in $sys_blp — template binding would fail" >&2; return 1; }

  awk '
    /^show_software_updates_group \(CcSystemPanel \*self\)$/ { infn = 1; print; next }
    infn && /^\{/ {
      print
      print "  /* Lisa: OS updates are systemd-sysupdate A/B swaps, always available. */"
      print "  return TRUE;"
      skip = 1
      next
    }
    infn && skip && /^\}/ { infn = 0; skip = 0; print; next }
    infn && skip { next }
    { print }
  ' "$sys_c" > "$sys_c.lisa" && mv "$sys_c.lisa" "$sys_c"
  ! grep -q 'gpk_update_viewer_exists ()' "$sys_c" \
    || { echo "show_software_updates_group body not replaced in $sys_c" >&2; return 1; }

  # The group is shown unconditionally: systemd-sysupdate is not optional
  # on a Track I system, so there is no configuration in which this page
  # should stay silent about the OS version.
  #
  # Deleting the two probes it used is part of the same edit, not tidying:
  # replacing the body alone leaves `gnome_software_allows_updates` and
  # `gpk_update_viewer_exists` defined-but-unused, and this tree builds
  # loudly enough that two new warnings are two too many. Removing them
  # also states the truth — Lisa does not probe for gnome-software at all.
  # `gnome_software_exists` STAYS: cc_system_page_open_software_update
  # still references it, and it is still bound as a template callback.
  awk '
    BEGIN { split("gnome_software_allows_updates gpk_update_viewer_exists", d, " ")
            for (i in d) dead[d[i]] = 1 }
    # The return type sits on the line before the name; hold it back so a
    # deleted function does not leave a dangling `static gboolean`.
    /^static gboolean$/ && !skip { held = $0; next }
    {
      name = $0; sub(/ .*/, "", name)
      if (held != "" && ($1 in dead) && $0 ~ /\(void\)$/) {
        held = ""; skip = 1; depth = 0; next
      }
      if (held != "") { print held; held = "" }
    }
    skip {
      depth += gsub(/\{/, "{") - gsub(/\}/, "}")
      if (depth <= 0 && $0 ~ /\}/) skip = 0
      next
    }
    { print }
    END { if (held != "") print held }
  ' "$sys_c" > "$sys_c.lisa" && mv "$sys_c.lisa" "$sys_c"
  ! grep -q 'gnome_software_allows_updates\|gpk_update_viewer_exists' "$sys_c" \
    || { echo "unused gnome-software probes still present in $sys_c" >&2; return 1; }
  grep -q 'gnome_software_exists' "$sys_c" \
    || { echo "gnome_software_exists was removed but is still referenced" >&2; return 1; }

  sed -i '/^#include "cc-system-panel.h"/a #include "cc-system-updates-lisa.h"' "$sys_c"
  sed -i '/gtk_widget_set_visible (GTK_WIDGET (self->software_updates_group), show_software_updates_group (self));/a\  lisa_system_updates_attach (ADW_PREFERENCES_GROUP (self->software_updates_group));' "$sys_c"
  grep -q 'lisa_system_updates_attach' "$sys_c" \
    || { echo "lisa_system_updates_attach call not inserted in $sys_c" >&2; return 1; }

  # Register it: build the panel lib, declare the GType, and list it.
  sed -i "s/^  'wellbeing',\$/  'wellbeing',\n  'lisa',/" panels/meson.build
  sed -i '/^extern GType cc_wellbeing_panel_get_type (void);/a extern GType cc_lisa_panel_get_type (void);' \
    shell/cc-panel-loader.c
  sed -i '/PANEL_TYPE("wellbeing",/a\  PANEL_TYPE("lisa",             cc_lisa_panel_get_type,                 NULL),' \
    shell/cc-panel-loader.c
}

build() {
  local meson_options=(
    -D documentation=true
    -D location-services=enabled
    -D malcontent=true
  )

  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

check() {
  GTK_A11Y=none dbus-run-session xvfb-run -s '-nolisten local +iglx -noreset' \
    meson test -C build --print-errorlogs
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_lisa-desktop-control-center() {
  provides=("gnome-control-center=$pkgver")
  conflicts=(gnome-control-center)
  # replaces= is what makes the rename actually HAPPEN (#284).
  # provides/conflicts describe the relationship once both names are
  # known to pacman; neither causes an upgrade. A machine with stock
  # `gnome-control-center` installed has nothing pulling a
  # differently-named package in, so `pacman -Syu` would leave it on
  # stock forever and the Intelligence panel would silently vanish on
  # the next GNOME bump. `replaces=` is the one directive that makes
  # -Syu offer the swap.
  replaces=(gnome-control-center)
  depends+=(lisa-desktop-keybindings)
  optdepends=(
    'fwupd: device security panel'
    'gnome-remote-desktop: screen sharing'
    'gnome-user-share: WebDAV file sharing'
    'malcontent: application permission control'
    'networkmanager: network settings'
    'openssh: remote login'
    'power-profiles-daemon: power profiles'
    'rygel: media sharing'
    'system-config-printer: printer settings'
  )
  groups=(gnome)

  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"
  _pick gkb usr/share/gettext/its/gnome-keybindings.*
  _pick gkb usr/share/gnome-control-center/keybindings
  _pick gkb usr/share/pkgconfig/gnome-keybindings.pc
}

package_lisa-desktop-keybindings() {
  pkgdesc="Keybindings configuration for GNOME applications (Lisa build)"
  provides=("gnome-keybindings=$pkgver")
  conflicts=(gnome-keybindings)
  replaces=(gnome-keybindings)
  depends=()

  mv gkb/* "$pkgdir"
}

